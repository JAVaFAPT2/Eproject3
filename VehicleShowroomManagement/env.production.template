# Backend Environment Variables for Render Deployment
# Copy this file to .env in the root directory

# Database Configuration
ConnectionStrings__MongoDB=mongodb://localhost:27017/VehicleShowroomManagement

# JWT Configuration
Jwt__Key=YourSuperSecretKeyThatIsAtLeast32CharactersLong!
Jwt__Issuer=VehicleShowroomAPI
Jwt__Audience=VehicleShowroomClient
Jwt__ExpireHours=24

# Email Configuration (Gmail SMTP)
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your-email@gmail.com
EmailSettings__SmtpPassword=your-app-password
EmailSettings__EnableSsl=true
EmailSettings__FromEmail=noreply@vehicleshowroom.com
EmailSettings__FromName=Vehicle Showroom Management

# Cloudinary Configuration (for image uploads)
CloudinarySettings__CloudName=your-cloud-name
CloudinarySettings__ApiKey=your-api-key
CloudinarySettings__ApiSecret=your-api-secret

# CORS Configuration
Cors__Origins=*

# Environment
ASPNETCORE_ENVIRONMENT=Production
