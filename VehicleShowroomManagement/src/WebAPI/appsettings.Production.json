{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "ApplicationName": "VehicleShowroomManagement",
    "KeyLifetime": "90.00:00:00",
    "PersistKeysToFileSystem": {
      "Directory": "/app/keys"
    }
  },
  "Cors": {
    "Origins": "*"
  }
}
