{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Warning",
      "Microsoft.AspNetCore.HttpsPolicy": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DataProtection": {
    "ApplicationName": "VehicleShowroomManagement",
    "KeyLifetime": "90.00:00:00",
    "PersistKeysToFileSystem": {
      "Directory": "/app/keys"
    }
  },
  "Cors": {
    "Origins": "http://localhost:3000;http://localhost:3001;http://localhost:8080;http://localhost:8081"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:10000"
      }
    }
  }
}
